# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME="Urban Essentials"
NEXT_PUBLIC_SITE_DESCRIPTION="Premium everyday bottles, bags, and lunchboxes."

# Supabase Credentials (from https://supabase.com dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Razorpay Payment Gateway (from https://dashboard.razorpay.com -> Settings -> API Keys & Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=rzp_live_or_test_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_string

# Admin Security Token & Credentials
ADMIN_SECRET_TOKEN=generate_a_random_32_char_secret_for_production
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your_secure_admin_password
ALLOWED_ADMIN_EMAILS=admin@your-domain.com,security@your-domain.com

# Email Service Configuration (Required for Admin 2FA OTP & Customer Notifications)
# Option 1: Gmail SMTP / Standard SMTP (Recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
EMAIL_FROM="Urban Essentials Security <your_email@gmail.com>"

# Option 2: Resend API (Alternative)
# RESEND_API_KEY=re_123456789
# RESEND_FROM="Urban Essentials Security <security@your-domain.com>"
